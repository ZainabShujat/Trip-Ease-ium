# ---------------------------------------------------------------------------
# Copy to .env.local (Next.js runtime) and .env (Prisma CLI), then fill in.
# .env and .env*.local are git-ignored. NEVER commit real values.
#
# Phase 1 note: the application and the full test suite run with NONE of these
# set. PROVIDER_MODE defaults to "mock", which uses deterministic local
# fixtures and makes zero network calls.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# PostgreSQL connection string. Required for Prisma commands and any route
# that reads or writes data. Not required for `npm test` or mock-mode pages.
# Neon example:
#   postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/travel_planner?sslmode=require
DATABASE_URL=

# --- Provider layer -------------------------------------------------------
# "mock" = deterministic fixtures, no network, no keys (default).
# "live" = real integrations. NOT IMPLEMENTED IN PHASE 1; selecting it raises
#          an explicit error rather than silently falling back to mock data.
PROVIDER_MODE=mock

# --- Phase 5: real place & routing data (not used yet) --------------------
# Server-side only. Must never be prefixed NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=
MAPTILER_API_KEY=

# --- Phase 6: LLM (not used yet) ------------------------------------------
# Isolated behind the LlmClient interface in src/ai/client.ts.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_REASONING=gemini-2.5-pro

# --- Phase 3: authentication (not used yet) -------------------------------
# Generate a secret with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
